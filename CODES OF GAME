    def raise_ui(self):
        c = self.canvas
        c.tag_raise(self.flash)
        c.tag_raise(self.overlay)
        for tag in ("banner", "sub", "count", "pause"):
            c.tag_raise(tag + "_sh")
            c.tag_raise(tag)
        for scr in self.SCREENS:
            c.tag_raise("scr_" + scr)
        c.tag_raise("toast_sh")
        c.tag_raise("toast")

    def show_screen(self, name):
        c = self.canvas
        for scr in self.SCREENS:
            c.itemconfig("scr_" + scr, state="hidden")
        c.itemconfig(self.overlay,
                     state="normal" if name in ("menu", "over", "pause")
                     else "hidden")
        if name:
            c.itemconfig("scr_" + name, state="normal")
        c.config(cursor="")
        self.raise_ui()

