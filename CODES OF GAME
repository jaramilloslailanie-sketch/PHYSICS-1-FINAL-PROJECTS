        self.bind("<Leave>", lambda e: self.config(bg=self.base))


class Mover:
    """Bounces back and forth between lo and hi at constant speed (px/s)."""

    def __init__(self, lo, hi, speed):
        self.lo, self.hi, self.speed = lo, hi, speed
        self.x = random.uniform(lo, hi)
        self.dir = random.choice((-1, 1))

    @property
    def vx(self):
        return self.dir * self.speed

    def update(self, dt):
        self.x += self.dir * self.speed * dt
        if self.x > self.hi:
            self.x = 2 * self.hi - self.x
            self.dir = -1
        elif self.x < self.lo:
            self.x = 2 * self.lo - self.x
            self.dir = 1


