    # Scenery
    # ------------------------------------------------------------------
    def draw_background(self):
        if self.bg_planet == self.planet:
            return
        self.bg_planet = self.planet
        c = self.canvas
        c.delete("bg")
        th = THEMES[self.planet]
        top, bottom = th["sky"]
        edge = th["edge"]
        gfill = mix(bottom, "#000000", 0.82)
        rng = random.Random(sum(map(ord, self.planet)))

        bands = 60
        for i in range(bands):
            t = i / (bands - 1)
            if th["stripes"]:
                t += 0.07 * math.sin(i * 1.1)
            y0 = i * self.GROUND_Y / bands
            y1 = (i + 1) * self.GROUND_Y / bands + 1
            c.create_rectangle(0, y0, self.CW, y1, fill=mix(top, bottom, t),
                               outline="", tags="bg")

        for _ in range(th["stars"]):
            x = rng.randint(0, self.CW)
            y = rng.randint(0, th["star_ymax"])
            s = rng.choice([1, 1, 2])
            c.create_oval(x, y, x + s, y + s, fill="#e0f2fe", outline="",
                          tags="bg")

        # distant orb with a ring
        ox, oy, orad = rng.randint(480, 620), rng.randint(90, 150), 34
        c.create_oval(ox - orad, oy - orad, ox + orad, oy + orad,
                      fill=mix(edge, bottom, 0.65), outline="", tags="bg",
                      stipple="gray50")
        c.create_oval(ox - orad * 1.8, oy - orad * .35, ox + orad * 1.8,
                      oy + orad * .35, outline=mix(edge, bottom, 0.3),
                      width=2, tags="bg")

        if th["cloud"]:
            for cx, cy in [(130, 190), (560, 220), (400, 150)]:
                for dx, dy, w, h in [(0, 0, 70, 26), (-24, 8, 50, 20),
                                     (26, 8, 54, 20)]:
                    c.create_oval(cx + dx - w / 2, cy + dy - h / 2,
                                  cx + dx + w / 2, cy + dy + h / 2,
                                  fill=th["cloud"], outline="",
                                  stipple="gray25", tags="bg")

        if th["city"]:                       # futuristic skyline
            x = -10
            while x < self.CW:
                w = rng.randint(20, 46)
                h = rng.randint(40, 125)
                c.create_rectangle(x, self.GROUND_Y - h, x + w,
                                   self.GROUND_Y, fill=gfill, outline="",
                                   tags="bg")
                if rng.random() < 0.3:      # antenna
                    c.create_line(x + w / 2, self.GROUND_Y - h,
                                  x + w / 2, self.GROUND_Y - h - 12,
                                  fill=edge, tags="bg")
                for wy in range(self.GROUND_Y - h + 6, self.GROUND_Y - 8, 10):
                    for wx in range(int(x) + 4, int(x + w) - 4, 8):
                        if rng.random() < 0.28:
                            c.create_rectangle(
                                wx, wy, wx + 3, wy + 4, outline="",
                                fill=mix(edge, "#ffffff", rng.random() * .5),
                                tags="bg")
                x += w + rng.randint(2, 10)

        # ground: neon cyber grid
        c.create_rectangle(0, self.GROUND_Y, self.CW, self.CH, fill=gfill,
                           outline="", tags="bg")
        grid = mix(edge, gfill, 0.72)
        for i in range(-16, 17):
            c.create_line(self.CW / 2 + i * 16, self.GROUND_Y,
                          self.CW / 2 + i * 62, self.CH, fill=grid, tags="bg")
        span = self.CH - self.GROUND_Y
        for k in range(1, 5):
            y = self.GROUND_Y + span * (k / 4) ** 1.7
            c.create_line(0, y, self.CW, y, fill=grid, tags="bg")
        for w, t in ((8, 0.8), (5, 0.55), (2, 0.0)):
            c.create_line(0, self.GROUND_Y, self.CW, self.GROUND_Y,
                          fill=mix(edge, gfill, t), width=w, tags="bg")

        # scanlines
        for y in range(0, self.CH, 4):
            c.create_line(0, y, self.CW, y, fill="#000000", stipple="gray12",
                          tags=("bg", "scan"))
        c.tag_lower("scan")
        c.tag_lower("bg")

    def draw_ruler(self):
        c = self.canvas
        c.delete("ruler")
        H = self.height
        raw = H / 5
        mag = 10 ** math.floor(math.log10(raw))
        step = min(m * mag for m in (1, 2, 5, 10) if m * mag >= raw)
        h = 0.0
        while h <= H + 1e-9:
            y = self.Y_LAND - h * self.scale
            c.create_line(48, y, 62, y, fill=ACCENT, width=2, tags="ruler")
            c.create_line(62, y, self.CW - 30, y, fill=ACCENT,
                          dash=(2, 10), tags="ruler")
            c.create_text(44, y, text=f"{h:g} m", anchor="e",
                          font=(FONT, 8, "bold"), fill=ACCENT, tags="ruler")
            h += step
        c.create_line(62, self.Y_LAND, 62, self.DROP_Y, fill=ACCENT,
                      width=2, tags="ruler")
        c.tag_lower("ruler")
        c.tag_lower("scan")
        c.tag_lower("bg")

    def update_info(self):
        left = (self.BOUNCES_PER_LEVEL
                - self.total_bounces % self.BOUNCES_PER_LEVEL)
        w = int(self.wind)
        wind = "calm" if abs(w) < 8 else ("►" if w > 0 else "◄") + f" {abs(w)}"
        text = (f"{self.planet.upper()} · g {self.g:.2f} · {self.height:g} m"
                f" · wind {wind} · next world in {left}")
        if self.guide:
            text += f" · fall {self.fall_time:.2f}s"
        self.canvas.itemconfig(self.info, text=text)

    # ------------------------------------------------------------------
    # World / level setup
    # ------------------------------------------------------------------
    def pick_height(self):
        if self.level == 1:
            return 15
        valid = [h for h in HEIGHTS
                 if 1.0 <= math.sqrt(2 * h / self.g) <= 2.2]
        return random.choice(valid or [1])

    def apply_level(self):
        lvl, cfg = self.level, self.cfg
        self.planet = ORDER[(lvl - 1) % len(ORDER)]
        self.g = PLANETS[self.planet]
        self.height = self.pick_height()
        self.scale = self.FALL_PX / self.height
        self.gpx = self.g * self.scale
        self.fall_time = math.sqrt(2 * self.height / self.g)
        apex_px = self.FALL_PX * 0.92
        self.v_launch = math.sqrt(2 * self.gpx * apex_px)
        self.tw_base = max(cfg["tw_min"], cfg["tw"] - cfg["shrink"] * (lvl - 1))
        self.vx_max = min(420.0, cfg["vx"] + 14 * lvl)
        self.drone.speed = min(240, cfg["drone"] + 8 * lvl)
        self.draw_background()
        self.draw_ruler()
        self.update_info()

    def clear_effects(self):
        c = self.canvas
        for d in self.trail:
            c.delete(d)
        self.trail.clear()
        for p in self.particles:
            c.delete(p[0])
        self.particles.clear()
        for pop in self.popups:
            c.delete(pop[0])
            c.delete(pop[1])
        self.popups.clear()
        for e in self.emps:
            for item in e["ids"]:
                c.delete(item)
        self.emps.clear()
        c.delete("ring")
        self.ring = None
        self.delete_coin()

    def reset_run_state(self):
        self.energy = 0.0
        self.shield = False
        self.wide_t = self.magnet_t = self.slow_t = self.stun_t = 0.0
        self.wind = self.wind_target = 0.0
        self.wind_timer = 2.0
        self.emp_timer = 4.0
        self.flash_t = 0.0

    # ------------------------------------------------------------------
    # Game flow
    # ------------------------------------------------------------------
    def rally_mult(self, n):
        return min(5.0, 1 + 0.2 * (n - 1))

    def set_status(self, text, color):
        self.status.config(text=text, fg=color)

    def save_game(self):
        write_save({"best": max(self.bests.values()), "bests": self.bests,
                    "diff": self.diff, "coins": self.coins,
                    "owned": self.owned, "equipped": self.equipped,
                    "stats": self.stats, "ach": self.ach, "upg": self.upg})

    def update_hud(self):
        self.best = max(self.best, self.score)
        self.stat_vars["SCORE"].set(f"{self.score:,}")
        self.stat_vars["BEST"].set(f"{self.best:,}")
        self.unit_vars["BEST"].set(self.diff.lower())
        self.stat_vars["COINS"].set(f"{self.coins:,}")
        self.stat_vars["WORLD"].set(str(self.level))
        self.unit_vars["WORLD"].set(self.planet.lower())
        self.stat_vars["LIVES"].set(
            "♥" * self.lives + "♡" * max(0, self.MAX_LIVES - self.lives))
        self.stat_vars["COMBO"].set(str(self.rally))
        self.unit_vars["COMBO"].set(
            f"next x{self.rally_mult(self.rally + 1):.2f}")

    def add_coins(self, n):
        n = max(1, int(round(n * (1 + 0.1 * self.upg["coin"])
                             * self.cfg["coin"])))
        self.coins += n
        self.run_coins += n
        return n

    def stat_max(self, key, value):
        if value > self.stats[key]:
            self.stats[key] = value

    def check_ach(self):
        for a in ACHIEVEMENTS:
            if a["id"] in self.ach:
                continue
            if self.stats[a["stat"]] >= a["target"]:
                self.ach.append(a["id"])
                self.coins += a["reward"]
                self.toasts.append(
                    f"MISSION COMPLETE: {a['name']}  +{a['reward']} ●")

    def refresh_menu_stats(self):
        self.canvas.itemconfig(
            self.menu_best, text=f"BEST ({self.diff})  {self.best:,}")
        self.canvas.itemconfig(self.menu_coins, text=f"● {self.coins:,}")
        self.canvas.itemconfig(self.btn_text["btn_diff"],
                               text=f"DIFFICULTY: {self.diff}",
                               fill=self.cfg["color"])

    def cycle_diff(self):
        if self.state != "menu":
            return
        i = (DIFF_ORDER.index(self.diff) + 1) % len(DIFF_ORDER)
        self.diff = DIFF_ORDER[i]
        self.apply_level()
        self.tw = self.target_tw()
        self.refresh_menu_stats()
        self.update_hud()
        self.save_game()

    def go_menu(self):
        if self.state in ("shop", "ach"):
            return
        self.clear_effects()
        self.reset_run_state()
        self.level = 1
        self.rally = 0
        self.total_bounces = 0
        self.score = 0
        self.lives = self.cfg["lives"] + self.upg["life"]
        self.squash = 0.0
        self.apply_level()
        self.state = "menu"
        self.show_screen("menu")
        self.put_text("banner", "GRAVITY BOUNCE", ACCENT)
        self.put_text("sub", MENU_SUB, "white")
        self.put_text("count", "")
        self.put_text("pause", "")
        self.refresh_menu_stats()
        self.pause_btn.config(text="⏸ PAUSE")
        self.update_hud()
        self.save_game()
        self.set_status("Welcome, pilot. Press PLAY", GREEN)

    def new_game(self):
        if self.state in ("shop", "ach"):
            return
        self.score = 0
        self.run_coins = 0
        self.lives = self.cfg["lives"] + self.upg["life"]
        self.level = 1
        self.rally = 0
        self.best_rally = 0
        self.total_bounces = 0
        self.best_start = self.best
        self.px = self.CW / 2
        self.pvx = 0.0
        self.squash = 0.0
        self.clear_effects()
        self.reset_run_state()
        self.apply_level()
        self.tw = self.target_tw()
        self.pause_btn.config(text="⏸ PAUSE")
        self.start_ready()
        self.update_hud()

    def start_ready(self):
        self.state = "ready"
        self.ready_timer = self.COUNTDOWN
        self.last_count = None
        self.stun_t = 0.0
        self.show_screen(None)
        self.put_text("banner", "")
        self.put_text("sub", "")
        self.put_text("pause", "")
        self.set_status("Get ready - the ball is released automatically",
                        ACCENT)

    def action(self):
        s = self.state
        if s in ("menu", "over"):
            self.new_game()
        elif s == "ready":
            self.ready_timer = 0.0
        elif s == "paused":
            self.toggle_pause()
        elif s == "result":
            self.result_timer = min(self.result_timer, 0.2)
        elif s == "play":
            if self.energy >= 100:
                self.slow_t = 4.0 * self.dur_mult()
                self.energy = 0.0
                self.add_popup(self.px, self.GROUND_Y - 50, "WARP!", VIOLET)
                self.flash_color, self.flash_t = VIOLET, 0.2

    def drop(self):
        self.bx, self.by = self.drone.x, float(self.DROP_Y)
        self.vx = self.drone.vx
        self.vy = 0.0
        self.frame_count = 0
        self.state = "play"
        self.wind_timer = 0.6
        self.put_text("count", "GO!", GREEN)
        self.count_timer = 0.6
        self.set_status("Keep it off the floor!", ORANGE)

    def toggle_pause(self):
        if self.state in ("ready", "play", "result"):
            self.prev_state = self.state
            self.state = "paused"
            self.show_screen("pause")
            self.put_text("pause", "PAUSED", "white")
            self.pause_btn.config(text="▶ RESUME")
            self.set_status("Paused", ORANGE)
        elif self.state == "paused":
            self.state = self.prev_state
            self.show_screen(None)
            self.put_text("pause", "")
            self.pause_btn.config(text="⏸ PAUSE")
            self.set_status("Go!", GREEN)

    def toggle_guide(self):
        self.guide = not self.guide
        self.guide_btn.config(text="GUIDE: ON" if self.guide else "GUIDE: OFF")
        self.update_info()

    # ------------------------------------------------------------------
    # Physics
    # ------------------------------------------------------------------
    def update_paddle(self, dt):
        old = self.px
        cfg = self.cfg
        self.tw = lerp(self.tw, self.target_tw(), min(1.0, dt * 9))
        half = self.tw / 2
        if self.stun_t > 0:                       # EMP: platform is frozen
            self.pvx = 0.0
            self.px = max(half, min(self.CW - half, self.px))
            return
        move = (1 if "R" in self.keys else 0) - (1 if "L" in self.keys else 0)
        if move:
            self.px += move * cfg["kb"] * dt
            self.mouse_active = False
        elif self.mouse_active and self.mouse_x is not None:
            step = cfg["mouse"] * dt              # limited paddle speed
            self.px += max(-step, min(step, self.mouse_x - self.px))
        self.px = max(half, min(self.CW - half, self.px))
        inst = (self.px - old) / dt if dt > 0 else 0.0
        inst = max(-600.0, min(600.0, inst))
        self.pvx = lerp(self.pvx, inst, 0.4)

    def update_effects(self, dt):
        for name in ("wide_t", "magnet_t", "slow_t", "stun_t", "flash_t"):
            v = getattr(self, name)
            if v > 0:
                setattr(self, name, max(0.0, v - dt))
        if self.toast_t > 0:
            self.toast_t -= dt
            if self.toast_t <= 0:
                self.put_text("toast", "")
        if self.toast_t <= 0 and self.toasts:
            self.put_text("toast", self.toasts.pop(0), GOLD)
            self.toast_t = 2.6
            self.update_hud()

    def update_wind(self, dt):
        self.wind_timer -= dt
        if self.wind_timer <= 0:
            self.wind_timer = random.uniform(3.5, 6.5)
            if self.level >= 2:
                strength = min(120.0, self.cfg["wind"] * (8 + 7 * self.level))
                self.wind_target = (random.choice((-1, 1)) * strength
                                    * random.uniform(0.4, 1.0))
            else:
                self.wind_target = 0.0
        self.wind = lerp(self.wind, self.wind_target, min(1.0, dt * 1.5))

    def update_ready(self, dt):
        self.ready_timer -= dt
        if self.ready_timer <= 0:
            self.drop()
            return
        n = min(3, int(self.ready_timer / 0.8) + 1)
        if n != self.last_count:
            self.last_count = n
            self.put_text("count", str(n),
                          {3: "#ffffff", 2: ORANGE, 1: RED}[n])

    def update_play(self, dt):
        r = self.BALL_R
        top = self.GROUND_Y - self.PLAT_H
        prev_bottom = self.by + r

        self.vy += self.gpx * dt
        self.vx += self.wind * dt
        self.bx += self.vx * dt
        self.by += self.vy * dt
        self.frame_count += 1

        if self.bx < r:
            self.bx = r
            self.vx = abs(self.vx)
        elif self.bx > self.CW - r:
            self.bx = self.CW - r
            self.vx = -abs(self.vx)
        if self.by < r:
            self.by = r
            self.vy = abs(self.vy)

        if self.coin is not None:
            reach = r + self.COIN_R * (2.6 if self.magnet_t > 0 else 1.0)
            if math.hypot(self.bx - self.coin["x"],
                          self.by - self.coin["y"]) <= reach:
                self.collect_coin()

        bottom = self.by + r
        if self.vy > 0 and prev_bottom <= top <= bottom:
            dx = self.bx - self.px
            if abs(dx) <= self.tw / 2 + r * 0.5:
                self.paddle_bounce(dx)
                return
        if bottom >= self.GROUND_Y:
            self.floor_hit()
            return
        if self.frame_count % 3 == 0:
            self.add_trail(self.bx, self.by)

    def paddle_bounce(self, dx):
        r = self.BALL_R
        top = self.GROUND_Y - self.PLAT_H
        half = self.tw / 2
        off = max(-1.0, min(1.0, dx / half))

        self.rally += 1
        self.total_bounces += 1
        self.best_rally = max(self.best_rally, self.rally)
        self.stats["bounces"] += 1
        self.stat_max("best_rally", self.rally)

        acc = 1.0 - abs(off)
        bullseye = abs(dx) <= half * 0.3
        if bullseye:
            self.stats["bullseyes"] += 1
        mult = self.rally_mult(self.rally)
        bonus = 1 if self.guide else 2
        pts = int((50 + 50 * acc + (25 if bullseye else 0)) * mult * bonus
                  * self.cfg["score"])
        self.score += pts
        self.add_popup(self.bx, top - 28, f"+{pts}",
                       GOLD if bullseye else "#ffffff")
        self.add_coins(2 if bullseye else 1)

        before = self.energy
        self.energy = min(100.0, self.energy + (16 if bullseye else 6)
                          * (1 + 0.2 * self.upg["energy"]))
        if before < 100 <= self.energy:
            self.add_popup(self.bx, top - 118, "WARP READY", VIOLET)

        if self.coin is not None:
            self.coin["left"] -= 1
            if self.coin["left"] <= 0:
                self.delete_coin()

        if self.total_bounces % self.BOUNCES_PER_LEVEL == 0:
            self.level += 1
            self.stat_max("max_level", self.level)
            self.add_coins(10)
            self.apply_level()
            self.wind_timer = 0.0
            self.put_text("banner",
                          f"WORLD {self.level}: {self.planet.upper()}", ACCENT)
            self.put_text("sub", f"g = {self.g:.2f} m/s²   ·   platform "
                                 f"{int(self.target_tw())}px   ·   +10 coins",
                          "white")
            self.banner_timer = 1.8
            self.save_game()
        else:
            self.update_info()

        if self.rally % 10 == 0:
            n = self.add_coins(5)
            self.add_popup(self.bx, top - 58, f"+{n} ●", GOLD)
        if self.rally % self.cfg["life_every"] == 0 \
                and self.lives < self.MAX_LIVES:
            self.lives += 1
            self.add_popup(self.bx, top - 88, "+1 LIFE", PINK)

        # launch back to the same height; landing spot sets sideways speed
        self.by = top - r
        self.vy = -self.v_launch
        vx = off * self.vx_max + 0.25 * self.pvx + random.uniform(-15, 15)
        cap = self.vx_max * 1.25
        vx = max(-cap, min(cap, vx))
        if abs(vx) < 40:
            vx = 40 if vx >= 0 else -40
        self.vx = vx

        self.spawn_coin()
        self.squash = self.SQUASH_TIME
        self.burst(self.bx, top, [ACCENT, "#ffffff", PINK],
                   14 if bullseye else 8, 160)
        self.check_ach()
        self.update_hud()

    def floor_hit(self):
        if self.shield:                          # energy barrier saves you
            self.shield = False
            self.by = self.GROUND_Y - self.BALL_R
            self.vy = -self.v_launch * 0.95
            self.add_popup(self.bx, self.GROUND_Y - 40, "SHIELD!", ACCENT)
            self.burst(self.bx, self.GROUND_Y, [ACCENT, "#ffffff"], 16, 190)
            self.flash_color, self.flash_t = ACCENT, 0.18
            return
        self.state = "result"
        self.result_timer = 1.8
        self.banner_timer = 0.0
        self.lives -= 1
        lost = self.rally
        self.rally = 0
        self.by = self.GROUND_Y - self.BALL_R
        self.vy = -abs(self.vy) * 0.45
        self.vx *= 0.6
        self.put_text("banner", "SIGNAL LOST", RED)
        self.put_text("sub", f"The ball touched the floor   ·   rally {lost}",
                      "white")
        self.burst(self.bx, self.GROUND_Y, ["#9ca3af", "#6b7280", RED],
                   16, 170)
        self.ring = [self.bx, 0.0, "#fca5a5"]
        self.flash_color, self.flash_t = RED, 0.25
        self.set_status("The ball hit the floor!", RED)
        self.update_hud()

    def update_dead_ball(self, dt):
        r = self.BALL_R
        self.vy += self.gpx * dt
        self.bx += self.vx * dt
        self.by += self.vy * dt
        if self.bx < r:
            self.bx, self.vx = r, abs(self.vx)
        elif self.bx > self.CW - r:
            self.bx, self.vx = self.CW - r, -abs(self.vx)
        if self.by + r >= self.GROUND_Y:
            self.by = self.GROUND_Y - r
            if abs(self.vy) > 60:
                self.vy = -self.vy * 0.45
            else:
                self.vy = 0.0
            self.vx *= 0.7

    def after_result(self):
        if self.lives <= 0:
            self.game_over()
            return
        self.clear_effects()
        self.start_ready()
        self.update_hud()

    def game_over(self):
        self.state = "over"
        new_best = self.score > self.best_start
        self.best = max(self.best, self.score)
        self.check_ach()
        self.save_game()
        self.update_hud()
        self.show_screen("over")
        line1 = f"Final score: {self.score:,}"
        if new_best:
            line1 += "     ★ NEW BEST! ★"
        msg = (f"{line1}\nWorld reached: {self.level} ({self.planet})     "
               f"Best rally: {self.best_rally}     [{self.diff}]\n"
               f"Coins earned this run: +{self.run_coins}")
        self.put_text("banner", "GAME OVER", RED)
        self.put_text("sub", msg, "white")
        self.put_text("count", "")
        self.set_status("Game over - spend your coins in the shop!", RED)

    # ------------------------------------------------------------------
    # EMP bombs
    # ------------------------------------------------------------------
    def update_emps(self, dt):
        cfg = self.cfg
        if self.level >= cfg["emp_start"]:
            self.emp_timer -= dt
            if self.emp_timer <= 0:
                base = max(2.0, cfg["emp_int"] - 0.25 * self.level)
                self.emp_timer = base * random.uniform(0.7, 1.2)
                self.spawn_emp()
        top = self.GROUND_Y - self.PLAT_H
        keep = []
        for e in self.emps:
            if e["warn"] > 0:
                e["warn"] -= dt
                keep.append(e)
                continue
            e["y"] += self.EMP_SPEED * dt
            if e["y"] + 10 >= top:
                if abs(e["x"] - self.px) <= self.tw / 2 + 8:
                    self.emp_hit(e["x"])
                else:
                    self.stats["emps"] += 1
                    self.burst(e["x"], top + 4, [RED, "#fda4af"], 6, 120)
                    self.check_ach()
                for item in e["ids"]:
                    self.canvas.delete(item)
                continue
            keep.append(e)
        self.emps = keep

    def spawn_emp(self):
        c = self.canvas
        half = self.tw / 2
        x = max(half, min(self.CW - half,
                          self.px + random.uniform(-220, 220)))
        idx = DIFF_ORDER.index(self.diff)
        warn = max(0.5, 1.0 - 0.04 * self.level - 0.1 * idx)
        line = c.create_line(0, 0, 0, 0, fill=RED, width=2, dash=(3, 5))
        tgt = c.create_oval(0, 0, 0, 0, outline=RED, width=2)
        glow = c.create_oval(0, 0, 0, 0, outline="#fda4af", width=2)
        body = c.create_oval(0, 0, 0, 0, fill=RED, outline="#ffffff", width=2)
        self.emps.append({"x": x, "y": 24.0, "warn": warn,
                          "ids": (line, tgt, glow, body)})

    def emp_hit(self, x):
        top = self.GROUND_Y - self.PLAT_H
        self.burst(x, top, [RED, "#fda4af", "#ffffff"], 14, 190)
        if self.shield:
            self.shield = False
            self.add_popup(x, top - 40, "SHIELD BREAK", ACCENT)
            self.flash_color, self.flash_t = ACCENT, 0.18
        else:
            self.stun_t = self.cfg["stun"]
            self.add_popup(x, top - 40, "EMP!", RED)
            self.flash_color, self.flash_t = RED, 0.22

    def render_emps(self):
        c = self.canvas
        top = self.GROUND_Y - self.PLAT_H
        blink = int(self.clock * 14) % 2 == 0
        for e in self.emps:
            line, tgt, glow, body = e["ids"]
            x, y = e["x"], e["y"]
            warning = e["warn"] > 0
            c.coords(line, x, 24, x, top)
            c.coords(tgt, x - 18, top - 4, x + 18, top + 4)
            c.coords(glow, x - 15, y - 15, x + 15, y + 15)
            c.coords(body, x - 9, y - 9, x + 9, y + 9)
            c.itemconfig(line, state="normal" if warning else "hidden",
                         fill=RED if blink else "#7f1d1d")
            c.itemconfig(tgt, outline=RED if blink or not warning
                         else "#7f1d1d")
            c.tag_raise(line)
            c.tag_raise(tgt)
            c.tag_raise(glow)
            c.tag_raise(body)

    # ------------------------------------------------------------------
    # Floating coins & power-ups
    # ------------------------------------------------------------------
    def spawn_coin(self):
        if self.coin is not None:
            return
        if (self.total_bounces + 1) % self.BOUNCES_PER_LEVEL == 0:
            return
        if random.random() > 0.8:
            return
        _, land_x = self.predict()
        if land_x is None:
            return
        r = self.BALL_R
        off = random.uniform(-0.75, 0.75)
        t_air = 2 * self.v_launch / self.gpx
        t = random.uniform(0.25, 0.75) * t_air
        x = reflect(land_x + off * self.vx_max * t, r, self.CW - r)
        y = self.Y_LAND - self.v_launch * t + 0.5 * self.gpx * t * t
        kind = "coin"
        if random.random() < 0.3:
            choices = ["wide", "magnet"] + ([] if self.shield else ["shield"])
            kind = random.choice(choices)
        ring, fill, label = PICKUPS[kind]
        c = self.canvas
        outer = c.create_oval(0, 0, 0, 0, fill=fill, outline=ring, width=2)
        inner = c.create_oval(0, 0, 0, 0, fill=mix(fill, ring, 0.4),
                              outline="")
        txt = c.create_text(0, 0, text=label, fill="white",
                            font=(FONT, 10, "bold"))
        self.coin = {"x": x, "y": y, "left": 2, "kind": kind,
                     "ids": (outer, inner, txt)}

    def collect_coin(self):
        it = self.coin
        x, y, kind = it["x"], it["y"], it["kind"]
        self.stats["pickups"] += 1
        d = 9.0 * self.dur_mult()
        if kind == "coin":
            n = self.add_coins(5)
            self.add_popup(x, y - 20, f"+{n} ●", GOLD)
        elif kind == "shield":
            self.shield = True
            self.add_popup(x, y - 20, "SHIELD", ACCENT)
        elif kind == "wide":
            self.wide_t = d
            self.add_popup(x, y - 20, "WIDE", PINK)
        else:
            self.magnet_t = d
            self.add_popup(x, y - 20, "MAGNET", ORANGE)
        self.burst(x, y, [PICKUPS[kind][0], PICKUPS[kind][1], "#ffffff"],
                   12, 150)
        self.delete_coin()
        self.check_ach()
        self.update_hud()

    def delete_coin(self):
        if self.coin is not None:
            for item in self.coin["ids"]:
                self.canvas.delete(item)
            self.coin = None

    def render_coin(self):
        if self.coin is None:
            return
        c = self.canvas
        x, y = self.coin["x"], self.coin["y"]
        bob = math.sin(self.clock * 3) * 3
        if self.coin["kind"] == "coin":
            sp = max(0.25, abs(math.cos(self.clock * 4)))
        else:
            sp = 1.0 + 0.08 * math.sin(self.clock * 8)
        r = self.COIN_R + (3 if self.coin["kind"] != "coin" else 0)
        outer, inner, txt = self.coin["ids"]
        c.coords(outer, x - r * sp, y + bob - r, x + r * sp, y + bob + r)
        c.coords(inner, x - r * sp * .6, y + bob - r * .6,
                 x + r * sp * .6, y + bob + r * .6)
        c.coords(txt, x, y + bob)
        c.tag_raise(outer)
        c.tag_raise(inner)
        c.tag_raise(txt)

    # ------------------------------------------------------------------
    # Prediction (aim guide) - includes wind
    # ------------------------------------------------------------------
    def predict(self):
        r = self.BALL_R
        top = self.GROUND_Y - self.PLAT_H
        if self.state == "ready":
            x, y, vx, vy = self.drone.x, float(self.DROP_Y), self.drone.vx, 0.0
        else:
            x, y, vx, vy = self.bx, self.by, self.vx, self.vy
        h = 1 / 60
        pts = []
        for _ in range(600):
            pb = y + r
            vy += self.gpx * h
            vx += self.wind * h
            x += vx * h
            y += vy * h
            if x < r:
                x, vx = r, abs(vx)
            elif x > self.CW - r:
                x, vx = self.CW - r, -abs(vx)
            if y < r:
                y, vy = r, abs(vy)
            pts.append((x, y))
            if vy > 0 and pb <= top <= y + r:
                return pts, x
        return pts, None

    # ------------------------------------------------------------------
    # Main loop
    # ------------------------------------------------------------------
    def tick(self):
        now = time.perf_counter()
        dt = min(0.05, now - self.last)
        self.last = now
        if self.state not in ("paused", "shop", "ach"):
            self.update(dt)
        self.after_id = self.root.after(self.FRAME_MS, self.tick)

    def update(self, dt):
        self.clock += dt
        gdt = dt * (self.WARP_SCALE if self.slow_t > 0 else 1.0)
        self.drone.update(dt)
        self.update_paddle(dt)
        self.update_effects(dt)

        s = self.state
        if s == "play":
            self.update_wind(gdt)
            self.update_emps(gdt)
            self.update_play(gdt)
        elif s == "ready":
            self.update_ready(dt)
        elif s == "result":
            self.update_dead_ball(gdt)
            self.result_timer -= dt
            if self.result_timer <= 0:
                self.after_result()

        if self.squash > 0:
            self.squash = max(0.0, self.squash - dt)
        if self.count_timer > 0:
            self.count_timer -= dt
            if self.count_timer <= 0:
                self.put_text("count", "")
        if self.banner_timer > 0:
            self.banner_timer -= dt
            if self.banner_timer <= 0 and self.state == "play":
                self.put_text("banner", "")
                self.put_text("sub", "")
        self.info_clock += 1
        if self.info_clock % 15 == 0 and self.state in ("play", "ready"):
            self.update_info()

        self.update_particles(gdt)
        self.update_popups(dt)
        self.update_ring(dt)
        self.update_streaks(dt)
        self.render()

    # ------------------------------------------------------------------
    # Rendering
    # ------------------------------------------------------------------
    def render(self):
        s = self.state
        attached = s in ("menu", "ready")
        self.render_paddle()
        self.render_drone(attached)
        self.render_guide()
        self.render_coin()
        self.render_emps()
        self.render_fx()

        if attached:
            self.draw_ball(self.drone.x, self.DROP_Y, self.drone.vx, 0.0)
        elif s == "play":
            self.draw_ball(self.bx, self.by, self.vx, self.vy, True)
        elif s in ("result", "over"):
            self.draw_ball(self.bx, self.by)
        self.raise_ui()

    def render_fx(self):
        c = self.canvas
        ready = self.energy >= 100
        w = 160 * self.energy / 100
        c.coords(self.en_fill, 63, 414, 63 + w, 422)
        if ready:
            col = ACCENT if int(self.clock * 6) % 2 == 0 else "#ffffff"
        else:
            col = mix(VIOLET, ACCENT, self.energy / 100)
        c.itemconfig(self.en_fill, fill=col)
        c.itemconfig(self.en_text, text="READY [SPACE]" if ready
                     else f"{int(self.energy)}%",
                     fill=ACCENT if ready else MUTED)

        parts = []
        if self.shield:
            parts.append("SHIELD")
        if self.wide_t > 0:
            parts.append(f"WIDE {self.wide_t:.0f}s")
        if self.magnet_t > 0:
            parts.append(f"MAGNET {self.magnet_t:.0f}s")
        if self.slow_t > 0:
            parts.append(f"WARP {self.slow_t:.0f}s")
        if self.stun_t > 0:
            parts.append("EMP STUN")
        txt = "  ·  ".join(parts)
        if txt != self.fx_cache:
            self.fx_cache = txt
            c.itemconfig(self.fx_text, text=txt)

        if self.shield and self.state in ("play", "ready", "result"):
            pulse = 0.5 + 0.5 * math.sin(self.clock * 6)
            c.itemconfig(self.barrier, state="normal",
                         fill=mix(ACCENT, "#ffffff", pulse * 0.6))
            c.tag_raise(self.barrier)
        else:
            c.itemconfig(self.barrier, state="hidden")

        if self.flash_t > 0:
            c.itemconfig(self.flash, state="normal", fill=self.flash_color)
        else:
            c.itemconfig(self.flash, state="hidden")

    def render_paddle(self):
        c = self.canvas
        half = self.tw / 2
        top = self.GROUND_Y - self.PLAT_H
        c.coords(self.plat, self.px - half, top, self.px + half,
                 self.GROUND_Y)
        c.coords(self.plat_glow, self.px - half - 2, top - 2,
                 self.px + half + 2, self.GROUND_Y + 2)
        gh = half * 0.3
        c.coords(self.plat_gold, self.px - gh, top + 2, self.px + gh,
                 self.GROUND_Y - 2)
        sk = self.plat_skin
        if sk.get("special") == "rainbow":
            outline = self.rainbow()
            c.itemconfig(self.plat_gold, fill=self.rainbow(0.5))
        else:
            outline = sk["outline"]
        glow = mix(outline, BG, 0.6)
        if self.stun_t > 0:
            blink = int(self.clock * 16) % 2 == 0
            outline = RED if blink else "#7f1d1d"
            glow = "#7f1d1d"
        elif self.wide_t > 0:
            glow = mix(PINK, BG, 0.4)
        c.itemconfig(self.plat, outline=outline)
        c.itemconfig(self.plat_glow, outline=glow)
        c.tag_raise(self.plat_glow)
        c.tag_raise(self.plat)
        c.tag_raise(self.plat_gold)

    def render_drone(self, attached):
        c = self.canvas
        x, y = self.drone.x, self.DRONE_Y
        flick = 9 + 7 * abs(math.sin(self.clock * 45))
        c.coords(self.body, x - 26, y - 8, x + 26, y + 8)
        for side, mast, rotor in ((-1, self.mast_l, self.rotor_l),
                                  (1, self.mast_r, self.rotor_r)):
            mx = x + side * 22
            c.coords(mast, mx, y - 7, mx, y - 14)
            c.coords(rotor, mx - flick, y - 14, mx + flick, y - 14)
        c.coords(self.light, x - 3, y - 3, x + 3, y + 3)
        c.itemconfig(self.light,
                     fill=RED if int(self.clock * 4) % 2 == 0 else "#7f1d1d")
        if attached:
            r = self.BALL_R
            c.coords(self.claw_l, x - 10, y + 6, x - r + 1, self.DROP_Y - 3)
            c.coords(self.claw_r, x + 10, y + 6, x + r - 1, self.DROP_Y - 3)
            c.itemconfig(self.claw_l, state="normal")
            c.itemconfig(self.claw_r, state="normal")
        else:
            c.itemconfig(self.claw_l, state="hidden")
            c.itemconfig(self.claw_r, state="hidden")

    def render_guide(self):
        c = self.canvas
        if self.guide and self.state in ("ready", "play"):
            pts, land_x = self.predict()
            n = self.GUIDE_N
            for i, dot in enumerate(self.guide_dots):
                if pts:
                    idx = max(0, min(len(pts) - 1,
                                     int((i + 1) * len(pts) / n) - 1))
                    x, y = pts[idx]
                    c.coords(dot, x - 2.5, y - 2.5, x + 2.5, y + 2.5)
                    c.itemconfig(dot, state="normal")
                else:
                    c.itemconfig(dot, state="hidden")
            if land_x is not None:
                r = self.BALL_R
                c.coords(self.ghost, land_x - r, self.Y_LAND - r,
                         land_x + r, self.Y_LAND + r)
                c.itemconfig(self.ghost, state="normal")
            else:
                c.itemconfig(self.ghost, state="hidden")
            self.guide_shown = True
        elif self.guide_shown:
            for dot in self.guide_dots:
                c.itemconfig(dot, state="hidden")
            c.itemconfig(self.ghost, state="hidden")
            self.guide_shown = False

    def draw_ball(self, x, y, vx=0.0, vy=0.0, shadow=False):
        c = self.canvas
        r = self.BALL_R
        sk = self.ball_skin
        if sk.get("special") == "rainbow":
            color, outline = self.rainbow(), "#ffffff"
        else:
            color = mix(sk["slow"], sk["fast"],
                        abs(vy) / (self.v_launch * 1.05))
            outline = sk["outline"]

        k = self.squash / self.SQUASH_TIME if self.squash > 0 else 0.0
        sx, sy = 1 + 0.4 * k, 1 - 0.35 * k
        cy = y + r * (1 - sy)
        rx, ry = r * sx, r * sy

        c.coords(self.ball, x - rx, cy - ry, x + rx, cy + ry)
        c.itemconfig(self.ball, fill=color, outline=outline)
        c.coords(self.ball_shine, x - rx * .6, cy - ry * .7,
                 x - rx * .1, cy - ry * .25)
        g = 6 + (4 if self.rally >= 20 else 0)       # overdrive glow
        c.coords(self.ball_glow, x - rx - g, cy - ry - g,
                 x + rx + g, cy + ry + g)
        glow = mix(color, "#ffffff", 0.3) if self.rally >= 20 \
            else mix(color, "#0b1d3a", .6)
        c.itemconfig(self.ball_glow, fill=glow, stipple="gray50")

        decor = sk.get("decor", [])
        for i, item in enumerate(self.decor):
            if i < len(decor):
                dx, dy, s, dcol = decor[i]
                ox, oy = x + dx * rx, cy + dy * ry
                c.coords(item, ox - s * r, oy - s * r, ox + s * r, oy + s * r)
                c.itemconfig(item, fill=dcol, state="normal")
            else:
                c.itemconfig(item, state="hidden")

        mag = math.hypot(vx, vy)
        length = min(70, mag * 0.14)
        if length > 8:
            ux, uy = vx / mag, vy / mag
            c.coords(self.arrow, x + ux * r, y + uy * r,
                     x + ux * (r + length), y + uy * (r + length))
        else:
            c.coords(self.arrow, 0, 0, 0, 0)

        if shadow:
            closeness = max(0.0, min(1.0, (y - self.DROP_Y) / self.FALL_PX))
            sw = 6 + 22 * closeness
            c.coords(self.shadow, x - sw, self.GROUND_Y + 3,
                     x + sw, self.GROUND_Y + 9)
            c.itemconfig(self.shadow, state="normal")
        else:
            c.itemconfig(self.shadow, state="hidden")

        c.tag_raise(self.ball_glow)
        c.tag_raise(self.arrow)
        c.tag_raise(self.ball)
        for i in range(min(3, len(decor))):
            c.tag_raise(self.decor[i])
        c.tag_raise(self.ball_shine)

    # ------------------------------------------------------------------
    # Effects
    # ------------------------------------------------------------------
    def add_trail(self, x, y):
        sk = self.ball_skin
        color = self.rainbow() if sk.get("special") == "rainbow" \
            else sk["trail"]
        dot = self.canvas.create_oval(x - 3, y - 3, x + 3, y + 3,
                                      fill=color, outline="",
                                      stipple="gray50")
        self.trail.append(dot)
        self.canvas.tag_lower(dot, self.ball_glow)
        if len(self.trail) > 30:
            self.canvas.delete(self.trail.pop(0))

    def burst(self, x, y, colors, n, speed):
        for _ in range(n):
            ang = random.uniform(math.pi * 1.05, math.pi * 1.95)
            sp = random.uniform(0.3, 1.0) * speed
            vx, vy = math.cos(ang) * sp, math.sin(ang) * sp
            s = random.choice((2, 3, 4))
            pid = self.canvas.create_oval(x - s, y - s, x + s, y + s,
                                          fill=random.choice(colors),
                                          outline="")
            self.particles.append([pid, x, y, vx, vy, 0.0,
                                   random.uniform(0.6, 1.3), s])

    def update_particles(self, dt):
        if not self.particles:
            return
        gpx = self.g * self.PART_SCALE
        keep = []
        for pid, x, y, vx, vy, age, life, s in self.particles:
            vy += gpx * dt
            x += vx * dt
            y += vy * dt
            age += dt
            if age >= life or y >= self.GROUND_Y:
                self.canvas.delete(pid)
                continue
            self.canvas.coords(pid, x - s, y - s, x + s, y + s)
            keep.append([pid, x, y, vx, vy, age, life, s])
        self.particles = keep

    def update_streaks(self, dt):
        c = self.canvas
        active = self.state in ("play", "result") and abs(self.wind) > 10
        if not active:
            if self.streaks_on:
                for st in self.streaks:
                    c.itemconfig(st[0], state="hidden")
                self.streaks_on = False
            return
        self.streaks_on = True
        sign = 1 if self.wind > 0 else -1
        for st in self.streaks:
            st[1] += self.wind * 3.0 * dt
            if st[1] > self.CW + 50:
                st[1] = -50
            elif st[1] < -50:
                st[1] = self.CW + 50
            c.coords(st[0], st[1], st[2], st[1] - sign * st[3], st[2])
            c.itemconfig(st[0], state="normal")

    def add_popup(self, x, y, text, color):
        font = (FONT, 14, "bold")
        sid = self.canvas.create_text(x + 2, y + 2, text=text, font=font,
                                      fill="#000000")
        mid = self.canvas.create_text(x, y, text=text, font=font, fill=color)
        self.popups.append([sid, mid, 0.0])

    def update_popups(self, dt):
        keep = []
        for sid, mid, age in self.popups:
            age += dt
            if age > 1.0:
                self.canvas.delete(sid)
                self.canvas.delete(mid)
                continue
            self.canvas.move(sid, 0, -50 * dt)
            self.canvas.move(mid, 0, -50 * dt)
            keep.append([sid, mid, age])
        self.popups = keep

    def update_ring(self, dt):
        if not self.ring:
            return
        x, age, color = self.ring
        age += dt
        self.canvas.delete("ring")
        if age > 0.45:
            self.ring = None
            return
        self.ring[1] = age
        r = 8 + age * 190
        yc = self.GROUND_Y - 4
        self.canvas.create_oval(x - r, yc - r / 4, x + r, yc + r / 4,
                                outline=color, width=max(1, 4 - int(age * 8)),
                                tags="ring")

    # ------------------------------------------------------------------
    def on_close(self):
        if self.after_id:
            self.root.after_cancel(self.after_id)
            self.after_id = None
        self.save_game()
        self.root.destroy()


