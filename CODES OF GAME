            c.create_text(x0 + 10, y0 + 13, anchor="w", text=a["name"],
                          fill=GREEN if done else TEXT,
                          font=(FONT, 11, "bold"), tags=tags)
            c.create_text(x0 + 10, y0 + 29, anchor="w", text=a["desc"],
                          fill=MUTED, font=(FONT, 9), tags=tags)
            label = (f"✓ +{a['reward']}●" if done
