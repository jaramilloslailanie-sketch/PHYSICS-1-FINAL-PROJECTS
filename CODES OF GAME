    def make_button(self, group, key, x, y, w, h, text, color, cmd,
                    size=14, state="hidden", extra=()):
        c = self.canvas
        tags = (group, key, "btn") + tuple(extra)
        rect = c.create_rectangle(x - w / 2, y - h / 2, x + w / 2, y + h / 2,
                                  fill=color,
                                  outline=mix(color, "#ffffff", .4),
                                  width=2, tags=tags, state=state)
        self.btn_text[key] = c.create_text(
            x, y, text=text, fill="white", font=(FONT, size, "bold"),
            tags=tags, state=state)
        hover = mix(color, "#ffffff", .18)
        c.tag_bind(key, "<Button-1>", lambda e: cmd())
        c.tag_bind(key, "<Enter>",
                   lambda e: (c.itemconfig(rect, fill=hover),
                              c.config(cursor="hand2")))
        c.tag_bind(key, "<Leave>",
                   lambda e: (c.itemconfig(rect, fill=color),
                              c.config(cursor="")))
        return rect

