    def apply_skins(self):
        self.ball_skin = SKIN_BY_ID["ball"][self.equipped["ball"]]
        self.plat_skin = SKIN_BY_ID["plat"][self.equipped["plat"]]
        sk = self.plat_skin
        self.canvas.itemconfig(self.plat, fill=sk["fill"],
                               outline=sk["outline"])
        self.canvas.itemconfig(self.plat_gold, fill=sk["center"])

    def rainbow(self, offset=0.0):
        h = (self.clock * 0.6 + offset) % 1.0
        r, g, b = colorsys.hsv_to_rgb(h, 0.75, 1.0)
        return "#%02x%02x%02x" % (int(r * 255), int(g * 255), int(b * 255))

    # ------------------------------------------------------------------
    # Sub screens: shop & missions
    # ------------------------------------------------------------------
    def open_sub(self, name, came_from):
        self.shop_from = came_from
        self.state = name
        self.show_screen(name)
        if name == "shop":
            self.shop_message = ("Click an item to buy or equip it", MUTED)
            self.draw_shop()
        else:
            self.draw_ach()

    def close_sub(self):
        if self.state not in ("shop", "ach"):
            return
        self.state = self.shop_from
        self.show_screen(self.shop_from)
        self.refresh_menu_stats()
        self.put_text("pause", "")

    def set_tab(self, kind):
        self.shop_tab = kind
        self.draw_shop()

    def draw_shop(self):
        c = self.canvas
        c.delete("shop_dyn")
        kind = self.shop_tab
        c.itemconfig(self.shop_coins, text=f"● {self.coins:,}")
        text, color = self.shop_message
        c.itemconfig(self.shop_msg, text=text, fill=color)

        for key, label, x in (("ball", "BALLS", 190),
                              ("plat", "PLATFORMS", 350),
                              ("upg", "UPGRADES", 510)):
            self.make_button("scr_shop", f"tab_{key}", x, 76, 150, 30, label,
                             "#6d28d9" if key == kind else "#1e293b",
                             lambda k=key: self.set_tab(k), size=11,
                             state="normal", extra=("shop_dyn",))
        if kind == "upg":
            self.draw_upgrades()
        else:
            self.draw_skin_cards(kind)
        self.raise_ui()

    def draw_skin_cards(self, kind):
        c = self.canvas
        for i, sk in enumerate(SKINS[kind]):
            col, row = i % 5, i // 5
            x0, y0 = 24 + col * 132, 112 + row * 118
            key = f"card_{kind}_{i}"
            tags = ("scr_shop", "shop_dyn", key)
            owned = sk["id"] in self.owned[kind]
            equipped = self.equipped[kind] == sk["id"]
            border = GREEN if equipped else ("#64748b" if owned else "#26324f")
            c.create_rectangle(x0, y0, x0 + 124, y0 + 108, fill=CARD,
                               outline=border, width=3 if equipped else 2,
                               tags=tags)
            if kind == "ball":
                self.preview_ball(x0 + 62, y0 + 34, 17, sk, tags)
            else:
                self.preview_plat(x0 + 62, y0 + 38, sk, tags)
            c.create_text(x0 + 62, y0 + 66, text=sk["name"], fill=TEXT,
                          font=(FONT, 10, "bold"), tags=tags)
            if equipped:
                label, lcol = "EQUIPPED", GREEN
            elif owned:
                label, lcol = "EQUIP", ACCENT
            else:
                label = f"● {sk['price']}"
                lcol = GOLD if self.coins >= sk["price"] else RED
            c.create_text(x0 + 62, y0 + 90, text=label, fill=lcol,
                          font=(FONT, 11, "bold"), tags=tags)
            c.tag_bind(key, "<Button-1>",
                       lambda e, k=kind, n=i: self.card_click(k, n))
            c.tag_bind(key, "<Enter>", lambda e: c.config(cursor="hand2"))
            c.tag_bind(key, "<Leave>", lambda e: c.config(cursor=""))

    def draw_upgrades(self):
        c = self.canvas
        for i, u in enumerate(UPGRADES):
            y0 = 108 + i * 46
            key = f"upg_{i}"
            tags = ("scr_shop", "shop_dyn", key)
            lvl = self.upg[u["id"]]
            maxed = lvl >= u["max"]
            price = u["base"] * (lvl + 1)
            c.create_rectangle(24, y0, 676, y0 + 40, fill=CARD,
                               outline=GREEN if maxed else "#26324f",
                               width=2, tags=tags)
            c.create_text(40, y0 + 13, anchor="w", text=u["name"], fill=TEXT,
                          font=(FONT, 11, "bold"), tags=tags)
            c.create_text(40, y0 + 29, anchor="w", text=u["desc"], fill=MUTED,
                          font=(FONT, 9), tags=tags)
            c.create_text(450, y0 + 20, anchor="w",
                          text="■" * lvl + "□" * (u["max"] - lvl),
                          fill=ACCENT, font=(FONT, 12, "bold"), tags=tags)
            if maxed:
                label, lcol = "MAX", GREEN
            else:
                label = f"● {price}"
                lcol = GOLD if self.coins >= price else RED
            c.create_text(660, y0 + 20, anchor="e", text=label, fill=lcol,
                          font=(FONT, 12, "bold"), tags=tags)
            c.tag_bind(key, "<Button-1>",
                       lambda e, n=i: self.buy_upgrade(n))
            c.tag_bind(key, "<Enter>", lambda e: c.config(cursor="hand2"))
            c.tag_bind(key, "<Leave>", lambda e: c.config(cursor=""))

    def preview_ball(self, cx, cy, r, sk, tags):
        c = self.canvas
        if sk.get("special") == "rainbow":
            cols = ["#ef4444", "#f59e0b", "#fde047", "#22c55e", "#38bdf8",
                    "#a855f7"]
            for j, col in enumerate(cols):
                c.create_arc(cx - r, cy - r, cx + r, cy + r, start=j * 60,
                             extent=60, fill=col, outline="", tags=tags)
            c.create_oval(cx - r, cy - r, cx + r, cy + r, outline="#ffffff",
                          width=2, tags=tags)
        else:
            col = mix(sk["slow"], sk["fast"], 0.3)
            c.create_oval(cx - r, cy - r, cx + r, cy + r, fill=col,
                          outline=sk["outline"], width=2, tags=tags)
            for dx, dy, s, dcol in sk["decor"]:
                c.create_oval(cx + dx * r - s * r, cy + dy * r - s * r,
                              cx + dx * r + s * r, cy + dy * r + s * r,
                              fill=dcol, outline="", tags=tags)
        c.create_oval(cx - r * .6, cy - r * .7, cx - r * .1, cy - r * .25,
                      fill="white", outline="", stipple="gray50", tags=tags)

    def preview_plat(self, cx, cy, sk, tags):
        c = self.canvas
        if sk.get("special") == "rainbow":
            outline, center = "#f472b6", "#38bdf8"
        else:
            outline, center = sk["outline"], sk["center"]
        c.create_rectangle(cx - 42, cy - 6, cx + 42, cy + 6, fill=sk["fill"],
                           outline=outline, width=2, tags=tags)
        c.create_rectangle(cx - 12, cy - 4, cx + 12, cy + 4, fill=center,
                           outline="", tags=tags)

    def card_click(self, kind, idx):
        sk = SKINS[kind][idx]
        sid = sk["id"]
        if sid in self.owned[kind]:
            self.equipped[kind] = sid
            self.shop_message = (f"{sk['name']} equipped", GREEN)
        elif self.coins >= sk["price"]:
            self.coins -= sk["price"]
            self.owned[kind].append(sid)
            self.equipped[kind] = sid
            self.shop_message = (f"Bought {sk['name']}!", GOLD)
        else:
            need = sk["price"] - self.coins
            self.shop_message = (f"Not enough coins - need {need} more", RED)
        self.apply_skins()
        self.save_game()
        self.update_hud()
        self.draw_shop()

    def buy_upgrade(self, idx):
        u = UPGRADES[idx]
        lvl = self.upg[u["id"]]
        price = u["base"] * (lvl + 1)
        if lvl >= u["max"]:
            self.shop_message = (f"{u['name']} is already maxed", MUTED)
        elif self.coins >= price:
            self.coins -= price
            self.upg[u["id"]] = lvl + 1
            self.shop_message = (f"{u['name']} upgraded to level {lvl + 1}!",
                                 GOLD)
        else:
            self.shop_message = (
                f"Not enough coins - need {price - self.coins} more", RED)
        self.save_game()
        self.update_hud()
        self.draw_shop()

    def draw_ach(self):
