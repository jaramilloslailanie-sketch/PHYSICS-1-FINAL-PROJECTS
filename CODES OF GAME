def default_save():
    return {"bests": {d: 0 for d in DIFFS}, "best": 0, "coins": 0,
            "diff": "MEDIUM",
            "owned": {"ball": ["classic"], "plat": ["steel"]},
            "equipped": {"ball": "classic", "plat": "steel"},
            "stats": {k: 0 for k in STAT_KEYS},
            "ach": [], "upg": {u: 0 for u in UPG_IDS}}


def load_save():
    data = default_save()
    try:
        with open(SAVE_FILE) as f:
            raw = json.load(f)
    except (OSError, ValueError):
        try:                                   # import v1 best score
            with open(OLD_BEST_FILE) as f:
                data["bests"]["MEDIUM"] = int(f.read().strip())
        except (OSError, ValueError):
            pass
        return data
    try:
        data["coins"] = max(0, int(raw.get("coins", 0)))
        bests = raw.get("bests")
        if isinstance(bests, dict):
            for d in DIFFS:
                data["bests"][d] = max(0, int(bests.get(d, 0)))
        else:                                  # v2 save: one best score
            data["bests"]["MEDIUM"] = max(0, int(raw.get("best", 0)))
        if raw.get("diff") in DIFFS:
            data["diff"] = raw["diff"]
        stats = raw.get("stats", {})
        for k in STAT_KEYS:
            data["stats"][k] = max(0, int(stats.get(k, 0)))
        data["ach"] = [a for a in raw.get("ach", []) if a in ACH_IDS]
        for u in UPGRADES:
            lvl = int(raw.get("upg", {}).get(u["id"], 0))
            data["upg"][u["id"]] = max(0, min(u["max"], lvl))
        for kind in ("ball", "plat"):
            valid = SKIN_BY_ID[kind]
            owned = [s for s in raw.get("owned", {}).get(kind, [])
                     if s in valid]
            for s in data["owned"][kind]:
                if s not in owned:
                    owned.append(s)
            data["owned"][kind] = owned
            eq = raw.get("equipped", {}).get(kind)
            if eq in owned:
                data["equipped"][kind] = eq
    except (TypeError, ValueError, AttributeError):
        return default_save()
    return data


def write_save(data):
    try:
        with open(SAVE_FILE, "w") as f:
            json.dump(data, f)
    except OSError:
        pass


# ---------- Helpers ----------
def lerp(a, b, t):
    return a + (b - a) * t


def hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def mix(c1, c2, t):
    t = max(0.0, min(1.0, t))
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    return "#%02x%02x%02x" % (
        int(lerp(r1, r2, t)), int(lerp(g1, g2, t)), int(lerp(b1, b2, t)))


def reflect(x, lo, hi):
    w = hi - lo
    d = (x - lo) % (2 * w)
    if d > w:
        d = 2 * w - d
    return lo + d


