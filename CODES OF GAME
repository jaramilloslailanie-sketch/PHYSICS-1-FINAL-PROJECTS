    def bind_keys(self):
        r = self.root
        r.bind("<space>", lambda e: self.action())
        r.bind("<Return>", lambda e: self.action())
        r.bind("<Escape>", lambda e: self.on_escape())
        for k in ("p", "P"):
            r.bind(k, lambda e: self.toggle_pause())
        for k in ("g", "G"):
            r.bind(k, lambda e: self.toggle_guide())
        for k in ("r", "R"):
            r.bind(k, lambda e: self.new_game())
        for key, d in (("Left", "L"), ("a", "L"), ("A", "L"),
                       ("Right", "R"), ("d", "R"), ("D", "R")):
            r.bind(f"<KeyPress-{key}>", lambda e, d=d: self.keys.add(d))
            r.bind(f"<KeyRelease-{key}>",
                   lambda e, d=d: self.keys.discard(d))
        r.bind("<FocusOut>", lambda e: self.keys.clear())
        self.canvas.bind("<Motion>", self.on_mouse)

    def on_mouse(self, event):
        self.mouse_x = event.x
        self.mouse_active = True

